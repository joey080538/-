/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_LPUART1_UART_Init();
  MX_TIM3_Init();
  /* USER CODE BEGIN 2 */
    // 強制將 TIM3 的 ARR 改為 999 消除閃爍
    __HAL_TIM_SET_AUTORELOAD(&htim3, 999);

    // 啟動 TIM3 Channel 3 (PC8) 的 PWM 硬體輸出
    HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_3);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
    while (1)
      {
        /* USER CODE BEGIN WHILE */

        /* --- 1. 外部按鈕 (PA12) 控制黃色 LED (PA11) --- */
        if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_12) == GPIO_PIN_RESET)
        {
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_SET);   // 點亮黃燈
        }
        else
        {
          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET); // 熄滅黃燈
        }

        /* --- 2. 序列埠字串指令控制綠色 LED (PC6) [不阻塞] --- */
        if (HAL_UART_Receive(&hlpuart1, &single_byte, 1, 1) == HAL_OK)
        {
          if (single_byte == '\r' || single_byte == '\n') // 收到 Enter 換行符號
          {
            if (rx_idx > 0)
            {
              rx_buf[rx_idx] = '\0'; // 補上字串結尾

              if (strcmp(rx_buf, "GREEN ON") == 0)
              {
                HAL_GPIO_WritePin(GPIOC, GPIO_PIN_6, GPIO_PIN_SET);   // 點亮綠燈
              }
              else if (strcmp(rx_buf, "GREEN OFF") == 0)
              {
                HAL_GPIO_WritePin(GPIOC, GPIO_PIN_6, GPIO_PIN_RESET); // 熄滅綠燈
              }

              rx_idx = 0; // 重置索引
            }
          }
          else
          {
            if (rx_idx < sizeof(rx_buf) - 1)
            {
              rx_buf[rx_idx++] = single_byte;
            }
            else
            {
              rx_idx = 0; // 超出緩衝區防呆
            }
          }
        }

        /* --- 3. 非阻塞式紅燈 (PC8) 呼吸燈狀態機邏輯 --- */
        if (breathing_enabled)
        {
          if (HAL_GetTick() - last_tick >= 10)
          {
            last_tick = HAL_GetTick();

            if (is_increasing == 1)
            {
              pulse_value += 10;
              if (pulse_value >= 999)
              {
                pulse_value = 999;
                is_increasing = 0;
              }
            }
            else
            {
              if (pulse_value <= 10)
              {
                pulse_value = 0;
                is_increasing = 1;
              }
              else
              {
                pulse_value -= 10;
              }
            }

            __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_3, pulse_value);
          }
        }
        else
        {
          __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_3, 0); // 關閉呼吸燈時歸零
          pulse_value = 0;
          is_increasing = 1;
        }

        /* USER CODE END WHILE */



    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

