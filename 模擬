uint32_t pulse_value = 0;                    // 記錄當前的 PWM CCR (亮度) 值，範圍 0 ~ 999
uint8_t is_increasing = 1;                   // 記錄呼吸方向：1 代表漸亮，0 代表漸暗

char rx_buf[20];                             // 序列埠指令接收緩衝陣列
uint8_t rx_idx = 0;                          // 緩衝陣列索引
uint8_t single_byte;                         // 暫存每次收到的單一字元
